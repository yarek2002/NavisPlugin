<Window x:Class="ClashManager.AutoNaming.Views.AutoNamingSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashManager.AutoNaming.Views"
        mc:Ignorable="d"
        Title="Настройки авто-наименования" Height="450" Width="550" WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок и режим наименования -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Настройки параметров наименования" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
            <!-- Режим полного наименования -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Режим наименования:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="CompleteCustomNamingToggle" Content="Настроить целиком (параметры составляют полное имя)" IsChecked="{Binding UseCompleteCustomNaming}" Checked="CompleteCustomNamingToggle_Checked" Unchecked="CompleteCustomNamingToggle_Unchecked" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="По умолчанию: Доп. настройка (добавление к базовому имени)" FontSize="10" Foreground="Gray" />
            <!-- Информация о базовых параметрах -->
            <StackPanel Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Параметры -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- Динамический список параметров -->
                <ItemsControl x:Name="ParametersItemsControl" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding ParameterName}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="⚙️" Click="SetParameterSettingsButton_Click" Tag="{Binding}" Width="30" ToolTip="Настройки параметра" />
                                <Button Grid.Column="3" Content="Удалить" Click="RemoveParameterButton_Click" Tag="{Binding}" Width="60" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Кнопка добавления параметра -->
                <Button x:Name="AddParameterButton" Content="Добавить параметр" HorizontalAlignment="Left" Margin="25,0,0,10" Click="AddParameterButton_Click" />

                <!-- Разделитель -->
                <TextBlock Text="Разделитель параметров" FontSize="10" FontWeight="Bold" Margin="10" />
                <TextBox x:Name="SeparatorTextBox" Text="{Binding SeparatorText, UpdateSourceTrigger=PropertyChanged}" Margin="25,10,0,10" />

                <!-- Чекбокс: разделить коллизии по парам (каждый результат в отдельной группе) -->
                <CheckBox x:Name="SeparateByTwoClashCheckBox"
                          Content="Разделить коллизии по парам (1 коллизия = 1 группа)"
                          IsChecked="{Binding SeparateByTwoClash}"
                          Margin="25,0,0,10" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="ApplyButton" Content="Применить" Width="100" Click="ApplyButton_Click" />
            <Button x:Name="CancelButton" Content="Отмена" Width="80" Margin="10,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>

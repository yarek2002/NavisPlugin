<Window x:Class="ClashManager.AutoNaming.Views.TestSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор тестов для применения настроек" Height="500" Width="600" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Выберите тесты, к которым применить настройки авто-наименования:" FontSize="14" FontWeight="Bold" Margin="10" />

        <!-- Список тестов -->
        <GroupBox Header="Тесты коллизий" Grid.Row="1" Margin="10,10,10,10">
            <ListBox x:Name="TestsListBox"
                     SelectionMode="Extended"
                     VirtualizingPanel.IsVirtualizing="False"
                     ScrollViewer.CanContentScroll="False">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="ScrollViewer"
                                      Focusable="false"
                                      ScrollChanged="TestsListBox_ScrollChanged">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Margin="0,0,6,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="TestCheckBox_Click"/>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="SelectAllButton" Content="Выбрать все" Width="100" Margin="0,0,10,0" Click="SelectAllButton_Click" />
            <Button x:Name="DeselectAllButton" Content="Снять все" Width="100" Margin="0,0,10,0" Click="DeselectAllButton_Click" />
            <Button x:Name="ApplyButton" Content="Применить" Width="100" Click="ApplyButton_Click" />
            <Button x:Name="CancelButton" Content="Отмена" Width="80" Margin="10,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
